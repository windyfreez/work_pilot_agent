# ============================================================================
# WorkPilot Agent 环境变量模板
# 用法：复制为 .env 后填写真实值。切勿把 .env 提交到 Git（已被 .gitignore 忽略）。
# 本文件只包含占位符，绝不写入真实密钥。
# ============================================================================

# ---- LLM（OpenAI 兼容协议：OpenAI / DeepSeek / Ollama 通用）----
# 模型名：OpenAI 用 gpt-*，DeepSeek 用 deepseek-chat，Ollama 用本地模型名
WORKPILOT_LLM_MODEL=gpt-4o-mini

# 可选：OpenAI 兼容端点；留空则使用官方端点
#   DeepSeek 示例：https://api.deepseek.com
#   Ollama  示例：http://localhost:11434/v1
WORKPILOT_LLM_BASE_URL=

# API 密钥（仅经环境变量注入，切勿写入代码 / 日志 / 提交）
WORKPILOT_LLM_API_KEY=

# 采样温度（0 = 更确定）
WORKPILOT_LLM_TEMPERATURE=0.0

# 单次模型请求超时（秒），留空表示不限
WORKPILOT_LLM_REQUEST_TIMEOUT=

# ---- Agent ----
# 单次运行整体超时（秒），留空表示不限
WORKPILOT_AGENT_TIMEOUT_SECONDS=

# 单次运行最多工具调用次数
WORKPILOT_AGENT_MAX_TOOL_CALLS=10

# ---- 任务流程（可控工作流）----
# 单次任务最多规划/执行步数
WORKPILOT_TASK_MAX_STEPS=5

# 单步失败最大重试次数
WORKPILOT_TASK_MAX_RETRIES=2

# 单次 run/resume 调用超时（秒），留空表示不限
WORKPILOT_TASK_TIMEOUT_SECONDS=

# checkpoint 持久化数据库路径
WORKPILOT_CHECKPOINT_DB_PATH=.workpilot/checkpoints.sqlite

# ---- RAG 知识库 ----
# Chroma 持久化目录
WORKPILOT_CHROMA_DIR=./chroma

# 向量化模型
WORKPILOT_EMBEDDING_MODEL=text-embedding-3-small

# 分块大小 / 重叠 / 检索条数
WORKPILOT_RAG_CHUNK_SIZE=500
WORKPILOT_RAG_CHUNK_OVERLAP=50
WORKPILOT_RAG_TOP_K=4

# 检索相关度阈值（余弦相似度，低于视为无相关资料；留空表示不过滤）
WORKPILOT_RAG_SCORE_THRESHOLD=

# ---- 文件工具 ----
# 授权目录：Agent 可读写的根目录；多个目录用 ';'(Windows) / ':'(POSIX) / ',' 分隔
WORKPILOT_ALLOWED_DIRS=./data

# read_document 读取上限（字节，默认 1 MB）
WORKPILOT_READ_MAX_BYTES=1000000
