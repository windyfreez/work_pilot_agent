# ============================================================================
# WorkPilot Agent 环境变量模板
# 用法：复制为 .env 后填写真实值。切勿把 .env 提交到 Git（已被 .gitignore 忽略）。
# 本文件只包含占位符，绝不写入真实密钥。
# ============================================================================

# ---- LLM 接入（阶段 3 启用，此处仅占位，勿在此填写真实 Key）----
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# ANTHROPIC_API_KEY=
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# ---- 模型默认值（阶段 3）----
# WORKPILOT_LLM_MODEL=
# WORKPILOT_EMBEDDING_MODEL=

# ---- 文件操作授权目录（Agent 可读写的根目录，路径校验依据）----
# 多个目录用平台分隔符（Windows 为 ';'，POSIX 为 ':'）分隔。
# WORKPILOT_ALLOWED_DIRS=

# ---- 本地向量库（Chroma 持久化目录，阶段 5）----
# WORKPILOT_CHROMA_DIR=./chroma

# ---- 日志 ----
# WORKPILOT_LOG_LEVEL=INFO
